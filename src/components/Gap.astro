---
import { Image } from 'astro:assets';
import { gap } from '../content/site';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
---

<section class="section" id="why">
  <div class="wrap">
    <div class="top">
      <SectionHeader eyebrow={gap.eyebrow} title={gap.title} intro={gap.intro} />
      <figure>
        <Image
          class="photo"
          src={gap.photo.src}
          alt={gap.photo.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 450px"
        />
      </figure>
    </div>

    <div class="pillars">
      {
        gap.pillars.map((p) => (
          <div class="card pillar">
            <div class="icon"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>

    <p class="punch">{gap.punchline}</p>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  figure { aspect-ratio: 16 / 10; }

  .pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 48px; }
  .pillar { padding: 26px; }
  .icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--soft);
    display: grid;
    place-items: center;
    margin-bottom: 16px;
    color: var(--accent-dk);
  }
  h3 { font-size: 20px; margin-bottom: 6px; }
  .pillar p { color: var(--muted); font-size: 15px; }

  .punch {
    margin-top: 56px;
    padding: 34px 38px;
    max-width: 36ch;
    border-left: 4px solid var(--accent);
    background: var(--card);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; gap: 32px; }
    .pillars { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .pillars { grid-template-columns: 1fr; margin-top: 32px; }
    .punch { padding: 22px; margin-top: 36px; }
  }
</style>
