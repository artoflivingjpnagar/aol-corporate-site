---
interface Props {
  steps: { title: string; text: string; tag: string }[];
}

const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="card step">
        <div class="n">Step {i + 1}</div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <span class="tag">{s.tag}</span>
      </li>
    ))
  }
</ol>

<style>
  .steps { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 48px; }
  .step { padding: 28px; }
  .n { font-family: var(--font-display); font-size: 15px; color: var(--accent-dk); font-weight: 600; margin-bottom: 12px; }
  h3 { font-size: 22px; margin-bottom: 8px; }
  p { color: var(--muted); font-size: 15px; }
  .tag {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
    background: var(--soft);
    padding: 5px 12px;
    border-radius: 999px;
  }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
