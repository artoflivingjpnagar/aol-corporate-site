---
import { Image, getImage } from 'astro:assets';
import { gallery, type GalleryPhoto } from '../content/site';
import SectionHeader from './ui/SectionHeader.astro';

// Full-size version for the lightbox (opened when a tile is tapped).
const withFull = async (p: GalleryPhoto) => ({
  ...p,
  full: (await getImage({ src: p.src, width: Math.min(p.src.width, 1600), format: 'webp' })).src,
});
const rowOne = await Promise.all(gallery.rowOne.map(withFull));
const rowTwo = await Promise.all(gallery.rowTwo.map(withFull));
---

<section class="section" id="centre">
  <div class="wrap">
    <SectionHeader eyebrow={gallery.eyebrow} title={gallery.title} intro={gallery.intro} />

    <div class="gallery">
      <div class="row">
        <div class="tile wide" style={`--ar:${gallery.video.ratio};--order:0`}>
          <video
            src={gallery.video.src}
            poster={gallery.video.poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={gallery.video.label}
          />
        </div>
        {
          rowOne.map((p) => (
            <button
              type="button"
              class:list={['tile', p.slot]}
              style={`--ar:${p.ratio};--order:${p.mobileOrder}`}
              data-full={p.full}
              aria-label={`View photo: ${p.alt}`}
            >
              <Image src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes="(max-width: 640px) 50vw, 40vw" />
            </button>
          ))
        }
      </div>
      <div class="row">
        {
          rowTwo.map((p) => (
            <button
              type="button"
              class:list={['tile', p.slot]}
              style={`--ar:${p.ratio};--order:${p.mobileOrder}`}
              data-full={p.full}
              aria-label={`View photo: ${p.alt}`}
            >
              <Image src={p.src} alt={p.alt} widths={[400, 800, 1200]} sizes="(max-width: 640px) 100vw, 34vw" />
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="close" aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</section>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>

<style>
  .gallery { margin-top: 44px; display: grid; gap: 12px; }

  /* Desktop: tiles in a row share one height; each grows by its aspect ratio, so photos are barely cropped. */
  .row { display: flex; gap: 12px; }
  .tile {
    flex: var(--ar) 1 0;
    aspect-ratio: var(--ar);
    min-width: 0;
    position: relative;
    overflow: hidden;
    border: 0;
    padding: 0;
    border-radius: 14px;
    background: var(--soft);
  }
  button.tile { cursor: zoom-in; }
  .tile :global(img),
  .tile video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  button.tile:hover :global(img) { transform: scale(1.03); }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 94vw; max-height: 92vh; margin: auto; }
  .lightbox::backdrop { background: rgba(15, 22, 28, 0.88); }
  .lightbox img { max-width: 94vw; max-height: 92vh; border-radius: 10px; }
  .close {
    position: fixed;
    top: 14px;
    right: 18px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  /* Mobile: 2-column mosaic. Video on top, tall photo beside two stacked halves, then wide photos. */
  @media (max-width: 640px) {
    .gallery { grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 32px; }
    .row { display: contents; }
    .tile { flex: none; border-radius: 12px; order: var(--order); }
    .wide { grid-column: span 2; }
    .tall { grid-row: span 2; aspect-ratio: 4 / 5; }
    .half { aspect-ratio: auto; }
    .half :global(img) { position: absolute; inset: 0; }
  }
</style>
